---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import BlogCard from './BlogCard.astro';
import DirectoryGroupHeader from './DirectoryGroupHeader.astro';
import DirectoryPostRow from './DirectoryPostRow.astro';
import DirectoryRecentLink from './DirectoryRecentLink.astro';
import { resolveDirs } from '../../lib/utils';
import { compareDirectoryPostMetadata } from '../../lib/postOrdering';
import { withBase } from '../../lib/urls';
import { DEFAULT_LAB_GROUP } from '../../config/labGroups.ts';
import powerGroupImage from '../../assets/groups/电源组.png';
import flightGroupImage from '../../assets/groups/飞控组.png';
import carGroupImage from '../../assets/groups/小车组.png';

interface Props {
  sort?: 'time' | 'oldest' | 'overview' | 'dir';
  dirOrder?: { dir1: string[]; dir2: Record<string, string[]> };
  posts?: CollectionEntry<'blog'>[];
}

type GroupVariant = 'power' | 'flight' | 'car' | 'other';
type GroupPresentation = { variant: GroupVariant; order: number; image?: ImageMetadata };
const groupPresentations: Record<string, GroupPresentation> = {
  电源组: { variant: 'power', order: 0, image: powerGroupImage },
  飞控组: { variant: 'flight', order: 1, image: flightGroupImage },
  小车组: { variant: 'car', order: 2, image: carGroupImage },
  其他: { variant: 'other', order: 3 },
};

const { sort = 'time', dirOrder = { dir1: [], dir2: {} }, posts: externalPosts } = Astro.props;
const byDirectoryOrder = (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => compareDirectoryPostMetadata(a.data.title, a.data.pubDate, b.data.title, b.data.pubDate, a.id, b.id);
let posts = externalPosts ?? await getCollection('blog');
posts = posts.map((post) => ({ ...post, data: { ...post.data, ...resolveDirs(post) } }));
if (sort === 'time') posts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
if (sort === 'oldest') posts = posts.sort(byDirectoryOrder);

let orderedData: Array<[string, Array<[string, CollectionEntry<'blog'>[]]>]> = [];
if (sort === 'dir' || sort === 'overview') {
  const grouped: Record<string, Record<string, CollectionEntry<'blog'>[]>> = {};
  for (const post of posts) {
    const dir1 = post.data.dir1 || DEFAULT_LAB_GROUP;
    const dir2 = post.data.dir2 || '';
    grouped[dir1] ??= {};
    grouped[dir1][dir2] ??= [];
    grouped[dir1][dir2].push(post);
  }

  const orderedDir1 = [
    ...dirOrder.dir1,
    ...Object.keys(grouped).filter((dir1) => !dirOrder.dir1.includes(dir1)).sort((a, b) => a.localeCompare(b)),
  ];

  orderedData = orderedDir1.map((dir1) => {
    const dir2Map = grouped[dir1] ?? {};
    const expectedDir2 = dirOrder.dir2[dir1] || [];
    const dir2List: Array<[string, CollectionEntry<'blog'>[]]> = [];
    for (const dir2 of expectedDir2) {
      if (dir2Map[dir2]) dir2List.push([dir2, dir2Map[dir2].sort(byDirectoryOrder)]);
    }
    if (dir2Map['']) dir2List.push(['', dir2Map[''].sort(byDirectoryOrder)]);
    for (const dir2 of Object.keys(dir2Map)) {
      if (dir2 === '' || expectedDir2.includes(dir2)) continue;
      dir2List.push([dir2, dir2Map[dir2].sort(byDirectoryOrder)]);
    }
    return [dir1, dir2List];
  });
}
---

<style>
  .card-grid {
    margin: 8px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    place-items: center; /* 单个元素时自动居中 */
    gap: 20px;
    list-style: none;
    padding: 0;
  }

  .blog-list,
  .directory-groups {
    min-width: 0;
  }

  .directory-groups {
    display: grid;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .directory-section {
    --directory-accent: var(--accent-light);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--directory-accent) 18%, var(--border));
    border-radius: 24px;
    background: color-mix(in srgb, var(--surface) 98%, var(--canvas));
    box-shadow:
      0 1px 0 color-mix(in srgb, white 64%, transparent) inset,
      0 24px 60px color-mix(in srgb, var(--text-primary) 8%, transparent),
      0 3px 12px color-mix(in srgb, var(--text-primary) 4%, transparent);
  }

  :global([data-theme='dark']) .directory-section {
    box-shadow:
      0 1px 0 color-mix(in srgb, white 8%, transparent) inset,
      0 24px 60px color-mix(in srgb, black 28%, transparent),
      0 3px 12px color-mix(in srgb, black 18%, transparent);
  }











  .directory-subsection-stack {
    display: grid;
    gap: 0.9rem;
    padding: 1.3rem 1.4rem 1.5rem;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--directory-accent) 5%, transparent), transparent 9rem),
      color-mix(in srgb, var(--surface-subtle) 48%, var(--surface));
  }

  .directory-subsection {
    overflow: clip;
    border: 1px solid color-mix(in srgb, var(--directory-accent) 24%, var(--border));
    border-radius: 16px;
    background: color-mix(in srgb, var(--surface) 97%, var(--directory-accent) 3%);
    box-shadow:
      0 1px 0 color-mix(in srgb, white 54%, transparent) inset,
      0 10px 28px color-mix(in srgb, var(--text-primary) 4.5%, transparent);
  }

  .directory-subsection > summary {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto auto;
    align-items: center;
    gap: 0.85rem;
    min-height: 5.35rem;
    padding: 0.95rem 1.1rem;
    cursor: pointer;
    list-style: none;
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  .directory-subsection > summary::before {
    position: absolute;
    top: 1rem;
    bottom: 1rem;
    left: 0;
    width: 3px;
    border-radius: 0 999px 999px 0;
    background: var(--directory-accent);
    content: '';
    opacity: 0.56;
    transition: opacity 150ms ease, transform 180ms var(--ease-out);
  }

  .directory-subsection[open] > summary::before {
    opacity: 1;
    transform: scaleY(1.16);
  }

  .directory-subsection > summary::-webkit-details-marker {
    display: none;
  }

  .directory-subsection > summary:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: -4px;
  }

  .directory-subsection-order {
    display: grid;
    width: 2.65rem;
    height: 2.65rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--directory-accent) 34%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--directory-accent) 10%, var(--surface));
    color: var(--directory-accent);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.68rem;
    font-weight: 760;
    letter-spacing: 0.04em;
  }

  .directory-subsection-title {
    display: block;
    min-width: 0;
  }

  .directory-subsection-label {
    display: block;
    margin: 0 0 0.18rem;
    color: var(--directory-accent);
    font-size: 0.58rem;
    font-weight: 760;
    letter-spacing: 0.13em;
    line-height: 1.15;
  }

  .directory-subsection-name {
    display: block;
    overflow: hidden;
    color: var(--text-primary);
    font-size: clamp(1rem, 1.7vw, 1.12rem);
    font-weight: 740;
    letter-spacing: -0.01em;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .directory-subsection-preview {
    display: block;
    max-width: 48rem;
    margin-top: 0.32rem;
    overflow: hidden;
    color: var(--text-secondary);
    font-size: 0.7rem;
    font-weight: 460;
    line-height: 1.45;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .directory-subsection-count {
    padding: 0.34rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
    border-radius: 999px;
    color: var(--text-secondary);
    font-size: 0.7rem;
    white-space: nowrap;
  }

  .directory-subsection-action {
    color: var(--directory-accent);
    font-size: 0.68rem;
    font-weight: 690;
    white-space: nowrap;
  }

  .directory-action-close,
  .directory-subsection[data-state='opening'] .directory-action-open,
  .directory-subsection[data-state='open'] .directory-action-open {
    display: none;
  }

  .directory-subsection[data-state='opening'] .directory-action-close,
  .directory-subsection[data-state='open'] .directory-action-close {
    display: inline;
  }

  .directory-subsection-chevron {
    display: grid;
    width: 2.15rem;
    height: 2.15rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--directory-accent) 26%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--directory-accent) 6%, transparent);
    color: var(--directory-accent);
    transition:
      background-color 160ms ease,
      color 160ms ease,
      transform 200ms var(--ease-out);
  }

  .directory-subsection-chevron svg {
    width: 0.9rem;
    height: 0.9rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .directory-subsection[data-state='opening'] .directory-subsection-chevron,
  .directory-subsection[data-state='open'] .directory-subsection-chevron {
    background: var(--directory-accent);
    color: var(--surface);
    transform: rotate(180deg);
  }

  .directory-subsection-panel {
    opacity: 1;
  }

  .directory-subsection:not([open]) > .directory-subsection-panel {
    display: none;
  }

  .directory-subsection-panel-inner {
    padding: 0.95rem;
    border-top: 1px solid color-mix(in srgb, var(--directory-accent) 17%, var(--border));
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--directory-accent) 3.5%, transparent), transparent 7rem),
      color-mix(in srgb, var(--canvas) 28%, var(--surface));
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 170ms var(--ease-out),
      transform 200ms var(--ease-out);
  }

  .directory-subsection[data-state='closed'] .directory-subsection-panel-inner,
  .directory-subsection[data-state='closing'] .directory-subsection-panel-inner {
    opacity: 0;
    transform: translateY(-6px);
  }

  .directory-third-level-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.15rem 0.2rem 0.65rem;
    color: var(--text-secondary);
    font-size: 0.66rem;
  }

  .directory-third-level-heading strong {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--directory-accent);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }

  .directory-third-level-heading strong::before {
    display: block;
    width: 1.2rem;
    height: 2px;
    border-radius: 999px;
    background: var(--directory-accent);
    content: '';
  }

  .directory-post-list {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .directory-overview-body {
    padding: 0.15rem 1.5rem 0.5rem;
  }

  .directory-overview-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0 0.65rem;
    color: var(--text-secondary);
    font-size: 0.72rem;
  }

  .directory-overview-heading strong {
    color: var(--text-primary);
    font-size: 0.76rem;
    font-weight: 680;
    letter-spacing: 0.04em;
  }

  .directory-overview-heading a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--directory-accent);
    font-weight: 680;
    text-decoration: none;
  }

  .directory-overview-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .directory-overview-empty {
    margin: 0;
    padding: 1rem 0 1.25rem;
    color: var(--text-secondary);
    font-size: 0.82rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .directory-subsection > summary:hover {
      background: color-mix(in srgb, var(--directory-accent) 7%, transparent);
    }

    .directory-subsection > summary:hover::before { opacity: 1; }

    .directory-overview-heading a:hover {
      text-decoration: underline;
      text-underline-offset: 0.22em;
    }
  }

  @media (max-width: 680px) {
    .directory-groups {
      gap: 1rem;
      margin-top: 1.2rem;
    }

    .directory-section {
      border-radius: 18px;
    }

    .directory-subsection-stack {
      gap: 0.65rem;
      padding: 0.8rem;
    }

    .directory-subsection > summary {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 0.65rem;
      min-height: 4.75rem;
      padding: 0.78rem 0.75rem 0.78rem 0.88rem;
    }

    .directory-subsection-order {
      width: 2.2rem;
      height: 2.2rem;
      border-radius: 9px;
    }

    .directory-subsection-preview {
      max-width: calc(100% - 3.4rem);
      font-size: 0.64rem;
    }

    .directory-subsection-action {
      display: none;
    }

    .directory-subsection-count {
      position: absolute;
      top: 0.86rem;
      right: 3.55rem;
      align-self: auto;
      padding: 0;
      border: 0;
      color: var(--text-secondary);
      font-size: 0.62rem;
      transform: none;
    }

    .directory-subsection-chevron {
      grid-column: 3;
      grid-row: 1;
    }

    .directory-subsection-panel-inner {
      padding: 0.65rem;
    }

    .directory-third-level-heading > span:last-child {
      display: none;
    }

    .directory-overview-body {
      padding-inline: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .directory-subsection > summary,
    .directory-subsection-chevron,
    .directory-subsection-panel-inner {
      transition: none;
    }

    .directory-subsection[data-state='closed'] .directory-subsection-panel-inner,
    .directory-subsection[data-state='closing'] .directory-subsection-panel-inner {
      transform: none;
    }
  }
  .directory-section[data-group='flight'] { --directory-accent: #3c78a9; }
  .directory-section[data-group='car'] { --directory-accent: #397f70; }
  .directory-section[data-group='other'] { --directory-accent: var(--accent-tertiary); }
  :global([data-theme='dark']) .directory-section[data-group='flight'] { --directory-accent: #8fc9f4; }
  :global([data-theme='dark']) .directory-section[data-group='car'] { --directory-accent: #81cdbb; }
  .directory-overview-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.62rem 1.5rem; border-bottom: 1px solid color-mix(in srgb, var(--directory-accent) 14%, var(--border)); background: color-mix(in srgb, var(--directory-accent) 4%, var(--surface)); }
  .directory-overview-heading p { margin: 0; color: var(--directory-accent); font-size: 0.66rem; font-weight: 760; letter-spacing: 0.1em; }
  .directory-overview-heading a { color: var(--directory-accent); font-size: 0.72rem; font-weight: 700; text-decoration: none; }
  .directory-recent-list { margin: 0; padding: 0; list-style: none; }
  .directory-empty { display: flex; align-items: center; gap: 0.7rem; margin: 0; padding: 1.15rem 1.5rem; color: var(--text-secondary); font-size: 0.82rem; }
  .directory-empty::before { width: 0.5rem; height: 0.5rem; border: 1px solid var(--directory-accent); border-radius: 50%; content: ''; opacity: 0.75; }
  .directory-section:has(.directory-group-link:active) { transform: perspective(1100px) translateY(-1px) scale(.996); }
    .directory-section:has(.directory-group-link:hover) {
</style>

<main class="blog-list">
  {sort === 'time' || sort === 'oldest' ? (
    <ul class="card-grid">{posts.map((post) => <BlogCard post={post} />)}</ul>
  ) : sort === 'overview' ? (
    <div class="directory-groups">
      {orderedData.map(([dir1, dir2List], index) => {
        const presentation = groupPresentations[dir1] ?? { variant: 'other' as const, order: index };
        const groupPosts = dir2List.flatMap(([, list]) => list);
        const recentPosts = [...groupPosts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
        const groupHref = withBase(`/blog/category/${encodeURIComponent(dir1)}/`);
        return (
          <section class="directory-section" data-group={presentation.variant} aria-labelledby={`directory-group-${index}`}>
            <DirectoryGroupHeader id={`directory-group-${index}`} title={dir1} count={groupPosts.length} index={presentation.order} variant={presentation.variant} image={presentation.image} href={groupHref} />
            <div class="directory-overview-heading"><p>近期更新</p><a href={groupHref}>查看分组 <span aria-hidden="true">→</span></a></div>
            {recentPosts.length > 0 ? (
              <ul class="directory-recent-list">{recentPosts.map((post) => <DirectoryRecentLink post={post} />)}</ul>
            ) : (
              <p class="directory-empty">该分组暂无文章，内容将在后续更新。</p>
            )}
          </section>
        );
      })}
    </div>
  ) : (
    <div class="directory-groups">
      {orderedData.map(([dir1, dir2List], index) => {
        const presentation = groupPresentations[dir1] ?? { variant: 'other' as const, order: index };
        const count = dir2List.reduce((total, [, list]) => total + list.length, 0);
        return (
          <section class="directory-section" data-group={presentation.variant} aria-labelledby={`directory-group-${index}`}>
            <DirectoryGroupHeader id={`directory-group-${index}`} title={dir1} count={count} index={presentation.order} variant={presentation.variant} image={presentation.image} />
            {dir2List.length === 0 ? (
              <p class="directory-empty">该分组暂无文章，内容将在后续更新。</p>
            ) : (
              <div class="directory-subsection-stack">
                {dir2List.map(([dir2, list], dir2Index) => {
                  const subsectionOrder = `02.${String(dir2Index + 1).padStart(2, '0')}`;
                  const panelId = `directory-panel-${index}-${dir2Index}`;
                  const title = dir2 || '未归入专题';
                  return (
                    <details class="directory-subsection" data-directory-accordion data-state="closed">
                      <summary aria-controls={panelId} aria-expanded="false">
                        <span class="directory-subsection-order" aria-hidden="true">{subsectionOrder}</span>
                        <span class="directory-subsection-title">
                          <span class="directory-subsection-label">二级专题</span>
                          <span class="directory-subsection-name" role="heading" aria-level="3">{title}</span>
                          <span class="directory-subsection-preview">{list.slice(0, 2).map(post => post.data.title).join(' · ')}</span>
                        </span>
                        <span class="directory-subsection-count">{list.length} 篇</span>
                        <span class="directory-subsection-action" aria-hidden="true">
                          <span class="directory-action-open">展开文章</span>
                          <span class="directory-action-close">收起文章</span>
                        </span>
                        <span class="directory-subsection-chevron" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="m5 8 5 5 5-5" /></svg></span>
                      </summary>
                      <div class="directory-subsection-panel" id={panelId} data-directory-panel role="region" aria-label={`${title}文章`}>
                        <div class="directory-subsection-panel-inner">
                          <div class="directory-third-level-heading"><strong>三级文章</strong><span>按学习顺序排列 · 点击标题进入正文</span></div>
                          <ol class="directory-post-list">{list.map((post, postIndex) => <DirectoryPostRow post={post} index={postIndex} />)}</ol>
                        </div>
                      </div>
                    </details>
                  );
                })}
              </div>
            )}
          </section>
        );
      })}
    </div>
  )}
</main>

<script>
  import { initializeDirectoryAccordions } from '../../scripts/directory-accordion';

  initializeDirectoryAccordions();
  document.addEventListener('astro:page-load', () => initializeDirectoryAccordions());
</script>
