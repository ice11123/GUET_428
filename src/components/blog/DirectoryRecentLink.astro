---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { blogPostPath } from '../../lib/urls';

interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const description = post.data.description.replace(/<[^>]+>/g, '').trim();
---

<li class="directory-recent-item">
  <a href={blogPostPath(post.id)}>
    <div>
      <h3>{post.data.title}</h3>
      <p>{description}</p>
    </div>
    <time><FormattedDate date={post.data.pubDate} /></time>
    <span class="directory-recent-arrow" aria-hidden="true">→</span>
  </a>
</li>

<style>
  .directory-recent-item { margin: 0; list-style: none; }
  .directory-recent-item + .directory-recent-item { border-top: 1px solid color-mix(in srgb, var(--border) 72%, transparent); }
  .directory-recent-item a { display: grid; grid-template-columns: minmax(0, 1fr) auto 2rem; align-items: center; gap: 1rem; padding: 0.9rem 1.5rem; color: inherit; text-decoration: none; transition: background-color 160ms var(--ease-out), transform 120ms var(--ease-out); }
  .directory-recent-item h3 { margin: 0; color: var(--text-primary); font-size: 0.92rem; font-weight: 700; line-height: 1.42; }
  .directory-recent-item p { overflow: hidden; margin: 0.28rem 0 0; color: var(--text-secondary); font-size: 0.78rem; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
  .directory-recent-item time { color: var(--text-secondary); font-size: 0.68rem; white-space: nowrap; }
  .directory-recent-arrow { display: grid; width: 1.8rem; height: 1.8rem; place-items: center; border: 1px solid color-mix(in srgb, var(--directory-accent) 28%, var(--border)); border-radius: 50%; color: var(--directory-accent); transition: background-color 160ms var(--ease-out), color 160ms var(--ease-out), transform 160ms var(--ease-out); }
  .directory-recent-item a:active { transform: scale(0.995); }
  @media (hover: hover) and (pointer: fine) { .directory-recent-item a:hover { background: color-mix(in srgb, var(--directory-accent) 5%, transparent); } .directory-recent-item a:hover .directory-recent-arrow { background: var(--directory-accent); color: var(--surface); transform: translateX(3px); } }
  @media (max-width: 680px) { .directory-recent-item a { grid-template-columns: minmax(0, 1fr) 1.8rem; gap: 0.6rem; padding: 0.85rem 1rem; } .directory-recent-item time { grid-column: 1; grid-row: 2; } .directory-recent-arrow { grid-column: 2; grid-row: 1 / span 2; } .directory-recent-item p { white-space: normal; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; } }
  @media (prefers-reduced-motion: reduce) { .directory-recent-item a, .directory-recent-arrow { transition: none; } .directory-recent-item a:active, .directory-recent-item a:hover .directory-recent-arrow { transform: none; } }
</style>
