---
import { INSTITUTION_NAME, LAB_NAME, PROGRAM_NAME, SITE_DESCRIPTION, SITE_START_DATE, SITE_TITLE } from '../consts';
import Layout from '../layouts/PublicContentLayout.astro';
import JsonLd from '../components/blog/JsonLd.astro';
import { withBase } from '../lib/urls';

const aboutUrl = new URL(withBase('/about/'), Astro.site).href;
const aboutPageLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: aboutUrl,
  mainEntity: {
    '@type': 'Organization',
    name: LAB_NAME,
    parentOrganization: {
      '@type': 'CollegeOrUniversity',
      name: INSTITUTION_NAME,
    },
  },
};
---

<Layout
  title={`关于 - ${SITE_TITLE}`}
  description={SITE_DESCRIPTION}
  pubDate={SITE_START_DATE}
  heading="关于"
>
  <JsonLd slot="head" data={aboutPageLd} />

  <h2>关于实验室</h2>
  <p><strong>{LAB_NAME}</strong>隶属于{INSTITUTION_NAME}{PROGRAM_NAME}专业。</p>
  <p>{SITE_DESCRIPTION}</p>

  <h2>关于本站</h2>
  <p>
    本站使用 Astro 构建，文章采用 Markdown 或 MDX 编写，并通过 GitHub Pages 自动部署。
  </p>
</Layout>
