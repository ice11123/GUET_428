---
import { getCollection } from 'astro:content';
import { INSTITUTION_NAME, LAB_NAME, PROGRAM_NAME, SITE_DESCRIPTION, SITE_START_DATE, SITE_TITLE } from '../consts';
import { fmtNum } from '../consts';
import Layout from '../layouts/PublicContentLayout.astro';
import JsonLd from '../components/blog/JsonLd.astro';
import GitHubRepoStats from '../components/github/GitHubRepoStats.astro';
import PublicStatus from '../components/home/PublicStatus.astro';
import { computeSiteStats } from '../lib/blogStats';
import { getRepoLanguages } from '../lib/repoStats';
import { withBase } from '../lib/urls';

const aboutUrl = new URL(withBase('/about/'), Astro.site).href;
const allPosts = await getCollection('blog');
const stats = computeSiteStats(allPosts);
const { repoLanguages, totalRepoLines } = getRepoLanguages();
const aboutPageLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: aboutUrl,
  mainEntity: {
    '@type': 'Organization',
    name: LAB_NAME,
    parentOrganization: {
      '@type': 'CollegeOrUniversity',
      name: INSTITUTION_NAME,
    },
  },
};
---

<Layout
  title={`关于 - ${SITE_TITLE}`}
  description={SITE_DESCRIPTION}
  pubDate={SITE_START_DATE}
  heading="关于"
>
  <JsonLd slot="head" data={aboutPageLd} />

  <h2>关于实验室</h2>
  <p><strong>{LAB_NAME}</strong>隶属于{INSTITUTION_NAME}{PROGRAM_NAME}专业。</p>
  <p>{SITE_DESCRIPTION}</p>

  <h2>关于本站</h2>
  <p>
    本站使用 Astro 构建，文章采用 Markdown 或 MDX 编写，并通过 GitHub Pages 自动部署。
  </p>

  <section class="about-site-info" aria-labelledby="about-site-info-title">
    <header class="site-info-heading">
      <div>
        <p>SITE NOTES</p>
        <h2 id="about-site-info-title">站点信息</h2>
      </div>
      <p>用于了解内容规模、技术构成与当前发布状态。</p>
    </header>

    <dl class="site-metrics" aria-label="站点统计">
      <div><dt>运行天数</dt><dd>{fmtNum(stats.daysSinceLaunch)}</dd></div>
      <div><dt>文章</dt><dd>{fmtNum(stats.totalArticles)}</dd></div>
      <div><dt>一级目录</dt><dd>{fmtNum(stats.totalCategories)}</dd></div>
      <div><dt>累计字数</dt><dd>{fmtNum(stats.totalWords)}</dd></div>
      <div><dt>仓库代码</dt><dd>{fmtNum(totalRepoLines)} 行</dd></div>
    </dl>

    <div class="site-info-grid">
      <section class="site-info-panel language-block" aria-labelledby="about-language-title">
        <div class="info-panel-heading">
          <span>01</span>
          <div><h3 id="about-language-title">技术构成</h3><p>GUET_428 网站仓库</p></div>
        </div>
        <GitHubRepoStats languages={repoLanguages} totalLines={totalRepoLines} />
      </section>

      <section class="site-info-panel status-block" aria-labelledby="about-status-title">
        <div class="info-panel-heading">
          <span>02</span>
          <div><h3 id="about-status-title">运行状态</h3><p>按需检测，不持续轮询</p></div>
          <button type="button" class="status-refresh" data-public-status-refresh aria-controls="public-status-grid" aria-label="重新检测系统状态">
            <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8.1 8.1 0 0 0-15.5-2M4 4v5h5M4 13a8.1 8.1 0 0 0 15.5 2M20 20v-5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span data-public-status-refresh-label>刷新</span>
          </button>
        </div>
        <PublicStatus />
      </section>
    </div>
  </section>
</Layout>

<style>
  .about-site-info { margin-top: 56px; padding-top: 44px; border-top: 1px solid var(--border); }
  .site-info-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
  .site-info-heading > div > p { margin: 0 0 8px; color: var(--accent); font-size: 12px; font-weight: 750; letter-spacing: .14em; }
  .site-info-heading h2 { margin: 0; }
  .site-info-heading > p { max-width: 360px; margin: 0; color: var(--text-secondary); font-size: 14px; text-align: right; }
  .site-metrics { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); margin: 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .site-metrics div { min-width: 0; padding: 20px 14px; }
  .site-metrics div + div { border-left: 1px solid var(--border); }
  .site-metrics dt { color: var(--text-secondary); font-size: 12px; }
  .site-metrics dd { margin: 6px 0 0; color: var(--text-primary); font-size: 20px; font-weight: 780; line-height: 1.2; }
  .site-info-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 36px; margin-top: 36px; }
  .site-info-panel { min-width: 0; }
  .site-info-panel + .site-info-panel { padding-left: 36px; border-left: 1px solid var(--border); }
  .info-panel-heading { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 20px; }
  .info-panel-heading > span { color: var(--accent); font-size: 12px; font-weight: 750; }
  .info-panel-heading h3 { margin: 0; color: var(--text-primary); font-size: 20px; }
  .info-panel-heading p { margin: 3px 0 0; color: var(--text-secondary); font-size: 13px; }
  .status-block .status-refresh { flex: 0 0 auto; margin-left: auto; }
  .language-block :global(.lang-card) { max-width: none; padding: 0; margin: 0; }
  .language-block :global(.lang-title) { text-align: left; }

  @media (max-width: 820px) {
    .site-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .site-metrics div + div { border-left: 0; }
    .site-metrics div:nth-child(even) { border-left: 1px solid var(--border); }
    .site-metrics div:nth-child(n + 3) { border-top: 1px solid var(--border); }
    .site-info-grid { grid-template-columns: 1fr; }
    .site-info-panel + .site-info-panel { padding-top: 32px; padding-left: 0; border-top: 1px solid var(--border); border-left: 0; }
  }

  @media (max-width: 560px) {
    .about-site-info { margin-top: 42px; padding-top: 34px; }
    .site-info-heading { display: block; }
    .site-info-heading > p { margin-top: 10px; text-align: left; }
    .site-metrics div:last-child { grid-column: 1 / -1; }
    .site-info-grid { margin-top: 30px; }
  }
</style>
