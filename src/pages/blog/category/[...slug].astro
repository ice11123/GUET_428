---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/PublicContentLayout.astro';
import BlogList from '../../../components/blog/BlogList.astro';
import JsonLd from '../../../components/blog/JsonLd.astro';
import { resolveDirs } from '../../../lib/utils';
import { LAB_GROUPS } from '../../../config/labGroups.ts';
import { DIR2_ORDER, SITE_START_DATE } from '../../../consts';
import { withBase } from '../../../lib/urls';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const pathSet = new Set<string>(LAB_GROUPS);
  for (const post of posts) {
    const { dir1, dir2 } = resolveDirs(post);
    if (dir1) {
      pathSet.add(dir1);
      if (dir2) pathSet.add(`${dir1}/${dir2}`);
    }
  }
  return Array.from(pathSet).map(p => ({ params: { slug: p } }));
}

const { slug } = Astro.params;
const categoryPath = slug!;
const segments = categoryPath.split('/');
const filterDir1 = segments[0];
const filterDir2 = segments.length >= 2 ? segments[1] : '';

const allPosts = await getCollection('blog');
const filtered = allPosts.filter(post => {
  const { dir1: d1, dir2: d2 } = resolveDirs(post);
  if (filterDir2) return d1 === filterDir1 && d2 === filterDir2;
  return d1 === filterDir1;
});
const latestPostDate = filtered.reduce(
  (latest, post) => post.data.pubDate > latest ? post.data.pubDate : latest,
  SITE_START_DATE,
);

const pageTitle = filterDir2 ? `分类: ${filterDir1} / ${filterDir2}` : `分类: ${filterDir1}`;
const pageDesc = `浏览 ${pageTitle} 下的所有文章`;

const collectionPageLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDesc,
  url: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  pubDate={latestPostDate}
  dir1={filterDir1}
  dir2={filterDir2}
  tags={[]}
  hidePageHeader={!filterDir2}
>
  <JsonLd slot="head" data={collectionPageLd} />

  {
    !filterDir2 ? (
      <section class="category-directory" aria-label={`${filterDir1}文章目录`}>
        <header class="category-directory-heading">
          <a href={withBase('/blog/')}>← 返回全部分组</a>
          <span><strong>{filtered.length}</strong> 篇文章</span>
        </header>
        <BlogList posts={filtered} sort="dir" dirOrder={{ dir1: [filterDir1], dir2: DIR2_ORDER }} />
      </section>
    ) : filtered.length > 0 ? (
      <BlogList posts={filtered} sort="oldest" />
    ) : (
      <p style="text-align: center; color: var(--foreground-dark);">该分类下暂无文章。</p>
    )
  }
</Layout>

<style>
  .category-directory { min-width: 0; padding-bottom: 3rem; }
  .category-directory-heading { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: 0.75rem 0; border-bottom: 1px solid color-mix(in srgb, var(--border) 86%, transparent); }
  .category-directory-heading a { color: var(--accent); font-size: 0.76rem; font-weight: 700; text-decoration: none; }
  .category-directory-heading > span { flex: none; padding: 0.45rem 0.7rem; border: 1px solid color-mix(in srgb, var(--border) 82%, transparent); border-radius: 999px; color: var(--text-secondary); font-size: 0.75rem; }
  .category-directory-heading strong { color: var(--text-primary); }
  @media (max-width: 680px) { .category-directory { padding-bottom: 2rem; } }
</style>
